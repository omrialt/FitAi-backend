# Server
PORT=3000
# 'production' disables the Swagger UI at /docs
NODE_ENV=development

# Database (required)
MONGO_URI=mongodb://localhost:27017/fitai

# JWT (required) — generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=7d

# Cloudinary (required)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth (required)
# NOTE: there are TWO redirect URIs and BOTH must be registered in Google Cloud:
#   1. Sign-in:       ${BACKEND_URL}/auth/google/callback  (derived, not set here)
#   2. Calendar sync: GOOGLE_REDIRECT_URI below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/calendar-sync/google/callback

# URLs
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Cron (serverless only) — shared secret Vercel Cron sends as
# `Authorization: Bearer <CRON_SECRET>` when calling /cron/calendar-sync.
# Without it that route refuses to run, since it would otherwise let anyone
# trigger a full sync across every connected user. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Not needed on long-running hosts, where the in-process @Cron is used instead.
CRON_SECRET=

# CORS — comma-separated origins allowed to call this API.
# localhost:5173 and localhost:3000 are always permitted; add deployed
# frontend origins (e.g. https://fitai.vercel.app) here.
CORS_ORIGINS=

# Email — Gmail app password (required)
EMAIL_USER=
EMAIL_PASS=

# Rate limiting — shared counter (serverless only, optional)
# express-rate-limit counts in process memory by default. On Vercel each warm
# lambda then holds its own count, so the real ceiling is (limit x instances)
# rather than the limit in the code. Setting both of these makes every instance
# count in one Upstash Redis database, which is what makes the numbers exact.
# Create a free database at https://console.upstash.com and copy the REST
# credentials (not the redis:// URL — this uses the HTTPS REST API, which is
# what survives a lambda freezing between invocations).
# Leave empty for local dev and single-process hosts: one process, one counter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
