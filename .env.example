# Server
PORT=3000

# Database (required)
MONGO_URI=mongodb://localhost:27017/fitai

# JWT (required) — generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=7d

# Cloudinary (required)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth (required)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/calendar-sync/google/callback

# URLs
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Email — Gmail app password (required)
EMAIL_USER=
EMAIL_PASS=
